---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { BRAND, SITE_URL, CONTACT, SOCIAL } from '../config/site';
import fontDisplay from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
import fontBody from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import { t, routes, locales, LANGS, type Lang, type PageId } from '../i18n';

interface Props {
  lang: Lang;
  page: PageId | 'notFound';
  /** Extra JSON-LD objects (e.g. FAQPage). */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { lang, page, schema = [], noindex = false } = Astro.props;
const d = t(lang);
const meta = d.meta.pages[page];
const abs = (p: string) => new URL(p, SITE_URL).href;
const canonical = page === 'notFound' ? undefined : abs(routes[page][lang]);
const ogImage = abs(`/og/${lang}.png`);

const sameAs = Object.values(SOCIAL).filter((u) => u && u !== '#');
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: BRAND.name,
  legalName: BRAND.legalName,
  url: abs(routes.home[lang]),
  logo: abs('/icon-512.png'),
  description: d.meta.pages.home.description,
  inLanguage: locales[lang].html,
  areaServed: ['TR', 'Worldwide'],
  ...(CONTACT.email && { email: CONTACT.email }),
  ...(CONTACT.phone && { telephone: CONTACT.phone }),
  ...(sameAs.length && { sameAs }),
};
const jsonLd = [org, ...schema];
---
<!doctype html>
<html lang={locales[lang].html} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontBody} as="font" type="font/woff2" crossorigin />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {page !== 'notFound' && LANGS.map((l) => <link rel="alternate" hreflang={locales[l].html} href={abs(routes[page][l])} />)}
    {page !== 'notFound' && <link rel="alternate" hreflang="x-default" href={abs(routes[page].tr)} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#08122c" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={locales[lang].og} />
    <meta property="og:locale:alternate" content={locales[lang === 'tr' ? 'en' : 'tr'].og} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} page={page} />
    <WhatsAppFab lang={lang} />

    <script>
      // Reveal-on-scroll (pure CSS transition, tiny observer).
      const els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
