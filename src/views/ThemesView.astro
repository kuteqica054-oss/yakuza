---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import ThemeArt from '../components/art/ThemeArt.astro';
import Icon from '../components/ui/Icon.astro';
import { themePalettes } from '../lib/themes';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const th = d.themes;
const p = d.pages.themes;
---
<BaseLayout lang={lang} page="themes">
  <PageHero eyebrow={p.eyebrow} title={p.title} sub={p.sub} tone="sun" />

  <section class="bg-paper py-16 lg:py-20" aria-labelledby="changes-title">
    <div class="container-x">
      <h2 id="changes-title" class="reveal text-2xl font-bold sm:text-3xl">{p.changesTitle}</h2>
      <dl class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {p.changes.map((c, i) => (
          <div class:list={["reveal border-l-4 pl-5", ['border-coral', 'border-cyan', 'border-sun', 'border-night-900'][i]]}>
            <dt class="flex items-center gap-2 font-display font-bold"><Icon name={c.icon} size={20} />{c.title}</dt>
            <dd class="muted mt-2">{c.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="scene-dark py-16 lg:py-24">
    <div class="container-x grid gap-16">
      {th.items.map((it, i) => (
        <article class="reveal grid items-center gap-8 lg:grid-cols-[1.25fr_1fr] lg:gap-14" id={it.id} aria-labelledby={`${it.id}-title`}>
          <div class:list={['overflow-hidden rounded-[var(--radius-blob)] ring-1 ring-night-700', i % 2 && 'lg:order-2']}>
            <ThemeArt id={it.id} alt={it.alt} class="block aspect-[400/260] w-full" />
          </div>
          <div>
            <p class="font-display text-sm font-bold text-night-300">0{i + 1}</p>
            <h2 id={`${it.id}-title`} class="mt-2 text-3xl font-bold sm:text-4xl">{it.name}</h2>
            <p class="mt-2 font-semibold text-cyan">{it.tagline}</p>
            <p class="mt-4 text-night-200">{it.text}</p>
            <h3 class="mt-6 font-sans text-sm font-bold text-sun">{th.missionsLabel}</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {it.missions.map((m) => <li class="rounded-full bg-night-800 px-3.5 py-1.5 text-sm ring-1 ring-night-700">{m}</li>)}
            </ul>
            <div class="mt-6 flex items-center gap-3">
              <span class="text-xs font-bold text-night-300">{th.paletteLabel}</span>
              <span class="flex gap-1.5">{themePalettes[it.id].map((c) => <span class="h-6 w-6 rounded-full ring-2 ring-night-700" style={`background:${c}`}></span>)}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <CtaBand lang={lang} />
</BaseLayout>
