---
import BaseLayout from '../layouts/BaseLayout.astro';
import Todo from '../components/ui/Todo.astro';
import Icon from '../components/ui/Icon.astro';
import { LEGAL_UPDATED } from '../config/site';
import { t, fmtDate, type Lang } from '../i18n';
interface Props { lang: Lang; doc: 'privacy' | 'terms' }
const { lang, doc } = Astro.props;
const l = t(lang).legal;
const content = l[doc];
---
<BaseLayout lang={lang} page={doc} noindex>
  <article class="bg-paper py-14 lg:py-20">
    <div class="container-x max-w-3xl">
      <p class="flex items-center gap-2 rounded-2xl bg-sun-soft px-5 py-4 font-bold text-sun-ink" role="note"><Icon name="FileText" size={20} />{l.draft}</p>
      <h1 class="mt-10 text-4xl font-bold sm:text-5xl">{content.title}</h1>
      <p class="mt-3 text-sm text-ink-soft">{l.updated}: <time datetime={LEGAL_UPDATED}>{fmtDate(lang, LEGAL_UPDATED)}</time></p>
      <div class="mt-10 grid gap-8">
        {content.sections.map((s) => (
          <section>
            <h2 class="text-xl font-bold">{s.h}</h2>
            {s.p.map((para) => <p class="muted mt-3"><Todo text={para} /></p>)}
          </section>
        ))}
      </div>
    </div>
  </article>
</BaseLayout>
