---
import { BRAND } from '../../config/site';
interface Props { dark?: boolean; class?: string }
const { dark = false, class: cls = '' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2.5', cls]}>
  <svg width="34" height="34" viewBox="0 0 64 64" aria-hidden="true" class="shrink-0">
    <rect width="64" height="64" rx="18" fill="#0c1a3d" />
    <path d="M10 46 L54 18" stroke="#ff5a4e" stroke-width="5" stroke-linecap="round" />
    <path d="M10 18 L54 46" stroke="#1fd6c8" stroke-width="5" stroke-linecap="round" />
    <circle cx="32" cy="32" r="9" fill="#ffc93c" stroke="#0c1a3d" stroke-width="3.5" />
  </svg>
  <span aria-hidden="true" class:list={['font-display font-bold leading-[0.9] tracking-tight text-[0.95rem]', dark ? 'text-paper' : 'text-ink']}>
    <span class="block">{BRAND.wordmark[0]}</span>
    <span class="block text-[0.72em] tracking-[0.18em]" class:list={[dark ? 'text-cyan' : 'text-coral-ink']}>{BRAND.wordmark[1]}</span>
  </span>
  <span class="sr-only">{BRAND.name}</span>
</span>
