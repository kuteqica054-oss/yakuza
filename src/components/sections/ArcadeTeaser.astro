---
import Icon from '../ui/Icon.astro';
import { t, routes, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const a = t(lang).arcade;
---
<section class="bg-paper pb-20 lg:pb-28" aria-labelledby="arcade-title">
  <div class="container-x">
    <div class="reveal relative grid items-center gap-8 overflow-hidden rounded-[var(--radius-blob)] bg-sun p-8 sm:p-12 lg:grid-cols-[1.4fr_1fr]">
      <div class="relative z-10">
        <p class="eyebrow text-ink">{a.eyebrow}</p>
        <h2 id="arcade-title" class="mt-4 text-3xl font-bold sm:text-4xl">{a.title}</h2>
        <p class="mt-4 max-w-xl text-lg text-ink/80">{a.text}</p>
        <a href={routes.arcade[lang]} class="btn btn-dark mt-7">{a.cta}<Icon name="ArrowRight" size={18} /></a>
      </div>
      <svg aria-hidden="true" viewBox="0 0 300 220" class="relative mx-auto w-full max-w-xs">
        <rect x="70" y="20" width="160" height="190" rx="22" fill="#0c1a3d" />
        <rect x="88" y="38" width="124" height="86" rx="10" fill="#13254f" />
        <circle cx="120" cy="80" r="16" fill="#ff5a4e" /><circle cx="160" cy="70" r="10" fill="#1fd6c8" /><circle cx="186" cy="96" r="7" fill="#ffc93c" />
        <rect x="96" y="104" width="60" height="6" rx="3" fill="#fbf8f2" opacity=".4" />
        <rect x="70" y="138" width="160" height="34" fill="#1d3366" />
        <circle cx="116" cy="155" r="10" fill="#ff5a4e" /><circle cx="148" cy="155" r="10" fill="#1fd6c8" /><rect x="172" y="148" width="30" height="14" rx="7" fill="#ffc93c" />
        <rect x="120" y="184" width="60" height="8" rx="4" fill="#fbf8f2" opacity=".3" />
        <path d="M30 60 l10 -18 l10 18 Z" fill="#0c1a3d" opacity=".25" /><circle cx="266" cy="44" r="10" fill="#0c1a3d" opacity=".2" /><rect x="250" y="150" width="20" height="20" rx="5" fill="#0c1a3d" opacity=".2" transform="rotate(20 260 160)" />
      </svg>
    </div>
  </div>
</section>
