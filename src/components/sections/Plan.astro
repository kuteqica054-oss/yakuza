---
import ArenaPlan from '../art/ArenaPlan.astro';
import SectionHead from '../ui/SectionHead.astro';
import Todo from '../ui/Todo.astro';
import LaserDivider from '../ui/LaserDivider.astro';
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t(lang).plan;
---
<section class="scene-dark relative overflow-hidden py-20 lg:py-28" aria-labelledby="plan-title">
  <LaserDivider variant="top" />
  <div class="container-x">
    <SectionHead eyebrow={p.eyebrow} title={p.title} sub={p.sub} dark tone="cyan" id="plan-title" />
    <div class="mt-12 grid gap-8 lg:grid-cols-[1.6fr_1fr]">
      <div class="reveal -mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
        <ArenaPlan alt={p.alt} zones={p.zones} flow={p.flow} class="w-full min-w-[34rem]" />
        <p class="mt-3 flex items-center gap-2 text-sm text-night-300"><span class="inline-block h-0.5 w-8 border-t-[3px] border-dotted border-sun"></span>{p.flow}</p>
      </div>
      <div class="grid content-start gap-6">
        <div class="reveal rounded-[var(--radius-blob)] bg-night-800 p-6 ring-1 ring-night-700">
          <h3 class="text-lg font-bold">{p.needsTitle}</h3>
          <dl class="mt-4 divide-y divide-night-700">
            {p.needs.map(([k, v]) => (
              <div class="flex items-baseline justify-between gap-4 py-3"><dt class="text-night-200">{k}</dt><dd class="text-right font-semibold"><Todo text={v} /></dd></div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>
